# =============================================================================
satsgate — Environment Variables
# Copy this file to .env and fill in all values before running.
# =============================================================================

# --- Core Security (REQUIRED) ------------------------------------------------
# L402 macaroon signing secret (generate: python3 -c "import secrets; print(secrets.token_hex(32))")
SATSGATE_MACAROON_SECRET=

# JWT signing key for LNURL-Auth sessions (generate: python3 -c "import secrets; print(secrets.token_hex(32))")
SATSGATE_JWT_SECRET=

# Operator admin token — protects /v1/admin/* endpoints
SATSGATE_ADMIN_TOKEN=

# --- Wallet Backend (REQUIRED for production) --------------------------------
# Wallet mode: "mock" (dev) or "lnaddr" (production via Lightning Address)
SATSGATE_WALLET_MODE=mock

# Lightning Address for receiving payments (only required when WALLET_MODE=lnaddr)
# Format: user@domain.com
SATSGATE_LIGHTNING_ADDRESS=

# --- Database ----------------------------------------------------------------
# PostgreSQL connection URL (asyncpg)
# In docker-compose, this is set automatically. For local dev:
DATABASE_URL=postgresql+asyncpg://aipp:changeme@localhost:5432/aipp

# --- Redis -------------------------------------------------------------------
# Redis connection (used for rate limiting, idempotency, LNURL-Auth sessions)
# In docker-compose, REDIS_PASSWORD is injected automatically.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- API Behavior ------------------------------------------------------------
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://aipp.dev,https://admin.aipp.dev,https://agentic.aipp.dev

# Rate limiting
RATE_LIMIT_PER_SEC=10
RATE_LIMIT_PER_MIN=100

# Daily spend limit per API key (in credits)
DAILY_SPEND_LIMIT=2000

# Free credits for new accounts
FREE_CREDITS=10

# --- Demo / Tickets ----------------------------------------------------------
# Price in sats for the demo /v1/tickets endpoint
SATSGATE_PRICE_SATS=10

# Token TTL in seconds (L402 macaroon expiry)
SATSGATE_TOKEN_TTL_SECONDS=600

# --- Rate Limit (legacy config, overridden by RATE_LIMIT_* above) -----------
SATSGATE_RL_ENABLED=1
SATSGATE_RL_WINDOW_SECONDS=60
SATSGATE_RL_MAX_ANON=60
SATSGATE_RL_MAX_AUTH=600

# --- Dev Mode ----------------------------------------------------------------
# Enable /dev/* endpoints (mock pay, etc.) — NEVER enable in production
SATSGATE_DEV_MODE=0

# --- SSRF Protection ---------------------------------------------------------
# Comma-separated allowlist for LNURL-pay callback domains.
# If empty, all domains are allowed (NOT recommended for production).
SATSGATE_SSRF_ALLOWED_DOMAINS=

# --- External URLs (optional) ------------------------------------------------
# Base URL for the API (used in LNURL callback generation)
API_BASE_URL=

# Callback base for LNURL auth (if behind a reverse proxy)
LNURL_CALLBACK_BASE=
