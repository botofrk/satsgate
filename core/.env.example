# =============================================================================
# AIPP Core Environment Variables
# =============================================================================
# Copy this file to .env and fill in ALL values before running docker compose.
# DO NOT commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Admin Tokens
# -----------------------------------------------------------------------------
# Used to protect /v1/admin/* endpoints and the operator dashboard.
# Both MUST be set to the same value (docker-compose passes them differently).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIPP_ADMIN_TOKEN=
SATSGATE_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# Cryptographic Secrets (CRITICAL — DO NOT use defaults in production!)
# -----------------------------------------------------------------------------
# Secret for signing L402 macaroon tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SATSGATE_MACAROON_SECRET=

# Secret for signing JWT tokens (LNURL-Auth sessions).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SATSGATE_JWT_SECRET=

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=aipp
POSTGRES_PASSWORD=
POSTGRES_DB=aipp

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Lightning / Wallet
# -----------------------------------------------------------------------------
# Wallet backend: "mock" (local dev) or "lnaddr" (production)
SATSGATE_WALLET_MODE=lnaddr

# Lightning Address for receiving payments (required when WALLET_MODE=lnaddr)
# Example: user@getalby.com
SATSGATE_LIGHTNING_ADDRESS=

# -----------------------------------------------------------------------------
# CORS Origins (comma-separated)
# -----------------------------------------------------------------------------
# Domains allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://aipp.dev,https://admin.aipp.dev,https://agentic.aipp.dev

# -----------------------------------------------------------------------------
# LNbits (optional)
# -----------------------------------------------------------------------------
LNURLPAY_URL=
