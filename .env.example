# AIPP.dev — Environment Variables Template
# Copy this file to .env and fill in real values

PORT=3000

# LNBits instance URL (use your own self-hosted or legend.lnbits.com)
LNBITS_URL=https://legend.lnbits.com

# Invoice key — read-only, used to create & verify invoices
LNBITS_INVOICE_KEY=your_lnbits_invoice_key_here

# Admin key — write access, used to send outgoing payments (payouts)
LNBITS_ADMIN_KEY=your_lnbits_admin_key_here

# Admin secret — dedicated credential for the admin override panel (defaults to LNBITS_ADMIN_KEY if not set)
ADMIN_SECRET=your_admin_secret_here

# Webhook secret — used to verify incoming LNBits webhook signatures
LNBITS_WEBHOOK_SECRET=change_this_to_a_long_random_string

# Dedicated HMAC secret for deriving Smart Tag access claims
AIPP_ACCESS_SECRET=change_this_to_a_different_long_random_string

# Reusable resource-scoped access token lifetime (default: 7 days, maximum: 30 days)
CONTENT_ACCESS_TOKEN_TTL_SECONDS=604800

# Fees & Limits
FEE_PER_REQUEST_SATS=5
DAILY_LIMIT_USD=100
MAX_SINGLE_REQUEST_USD=10
MIN_TOPUP_SATS=100

# NODE_ENV — set to "production" on live server
NODE_ENV=production

# DeepSeek Chat API Key (optional, for assistant)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Resend API Key (optional, for email alerts)
RESEND_API_KEY=your_resend_api_key_here
# Signs portable Open Tag receipts. Generate a long random value in production.
AIPP_RECEIPT_SECRET=

# Optional server-only demo seed. Leave all three unset to disable it.
AIPP_DEMO_MERCHANT_API_KEY=
AIPP_DEMO_LN_ADDRESS=
AIPP_DEMO_USDC_ADDRESS=
