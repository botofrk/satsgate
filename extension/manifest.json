{
  "manifest_version": 3,
  "name": "aipp.dev — Monetization & Autopay",
  "version": "1.0.0",
  "description": "Lock any web content or API in 1-click. Auto-pay micropayments via Bitcoin Lightning & Base USDC.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "aipp.dev Extension"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://aipp.dev/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "css": ["content/content.css"],
      "js": ["content/content.js"]
    }
  ]
}
