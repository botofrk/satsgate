{
  "manifest_version": 3,
  "name": "aipp.dev — 1-Click Smart Price Tag",
  "version": "1.2.0",
  "description": "Create one Open Smart Tag that works for people and agents with Lightning or Base USDC.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "aipp Smart Tag"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://aipp.dev/*"
  ]
}
